{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen2.5-coder-7b-instruct@q4_k_m": {
          "name": "Qwen 2.5 Coder 7B instruct Q4_K_M"
        },
        "ibm/granite-4-h-tiny": {
          "name": "Granite 4 H Tiny"
        },
        "granite-8b-code-instruct-128k@q4_k_m": {
          "name": "Granite 8B Code Instruct Q4_K_M"
        }
      }
    }
  },
  "agent": {
    "orchestrator": {
      "description": "Main assistant for complex coordination and coding tasks.",
      "mode": "primary",
      "model": "lmstudio/qwen2.5-coder-7b-instruct@q4_k_m",
      "temperature": 0.3,
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "task": {
          "*": "allow"
        },
        "bash": {
          "git push": "ask",
          "rm -rf *": "deny",
          "*": "allow"
        }
      }
    },
    "docs-writer": {
      "description": "Writes and maintains project documentation.",
      "mode": "subagent",
      "model": "lmstudio/granite-8b-code-instruct-128k@q4_k_m",
      "temperature": 0.4,
      "prompt": "You are a technical writer. Create clear, comprehensive documentation with code examples.",
      "tools": {
        "bash": false,
        "write": true
      }
    },
    "code-reviewer": {
      "description": "Reviews code for best practices, security, and performance.",
      "mode": "subagent",
      "model": "lmstudio/qwen2.5-coder-7b-instruct@q4_k_m",
      "temperature": 0.1,
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability. Do not make direct changes.",
      "tools": {
        "write": false,
        "edit": false
      },
      "permission": {
        "edit": "deny"
      }
    },
    "creative-brainstormer": {
      "description": "Agent for brainstorming and high-variability exploration.",
      "mode": "subagent",
      "model": "lmstudio/granite-8b-code-instruct-128k@q4_k_m",
      "temperature": 0.8,
      "tools": {
        "write": false,
        "bash": false
      }
    },
    "deep-thinker": {
      "description": "High reasoning effort for complex logic and architectural problems.",
      "mode": "subagent",
      "model": "lmstudio/qwen2.5-coder-7b-instruct@q4_k_m",
      "temperature": 0.1,
      "maxSteps": 15
    },
    "fast-explorer": {
      "description": "Low-latency agent for searching files and code patterns.",
      "mode": "subagent",
      "model": "lmstudio/ibm/granite-4-h-tiny",
      "temperature": 0,
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    }
  }
}
